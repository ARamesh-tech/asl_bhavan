# =============================================================================
# ASL Bhavan - environment configuration
# Copy to `.env` for local development. NEVER commit `.env`.
# Everything here is server-side only unless prefixed NEXT_PUBLIC_.
# =============================================================================

# --- Database (Aiven PostgreSQL in production) --------------------------------
# Aiven requires SSL. Keep `sslmode=require`.
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/asl_bhavan?sslmode=require"
# Max pooled connections for THIS process. Aiven free tier allows ~20 total;
# keep this low (3-5) so migrations/studio/other instances can still connect.
DATABASE_POOL_MAX=5
# Optional: Aiven "CA certificate" (PEM, newlines as \n) to fully verify the TLS chain.
# Without it the connection is still encrypted but the certificate chain is not verified.
DATABASE_CA_CERT=

# --- Application ----------------------------------------------------------------
NODE_ENV=development
# Public origin of the site (no trailing slash). Used in emails, receipts, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 48`. Used to sign auth cookies.
SESSION_SECRET=

# --- Initial admin (used ONLY by `npm run prisma:seed`; created if missing) -----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME="ASL Bhavan Admin"

# --- Razorpay (all server-side; the key id is sent to the browser per order) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard -> Webhooks. Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# --- Email over SMTP (Gmail app password, Zoho, Brevo, SES, Mailgun, ...) ------------
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=you@gmail.com  SMTP_PASS=<16-char App Password (2-step verification required)>
# Zoho: smtp.zoho.in:587 | Brevo: smtp-relay.brevo.com:587 | SES: email-smtp.<region>.amazonaws.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to guests. Gmail rewrites it to the authenticated account unless it is a verified alias.
EMAIL_FROM="ASL Bhavan <bookings@yourdomain.com>"
# Fallback owner inbox for new bookings / contact messages (overridable in Admin -> Settings)
OWNER_NOTIFICATION_EMAIL=

# --- Instagram (Instagram Graph API; Business/Creator account linked to a FB Page) --
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Scheduled housekeeping (GET /api/cron/expire-holds with Authorization: Bearer) ---
CRON_SECRET=

# --- Public contact / links (fallbacks; editable in Admin -> Settings) --------------
NEXT_PUBLIC_WHATSAPP_NUMBER=916374218715
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/NL45YLWuZRsR66wMA

# --- File storage (room photos, gallery, post images, receipt PDFs) ----------------
# local  -> files written to ./public/uploads (dev only; NOT persistent on Render)
# s3     -> any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket/CDN, e.g. https://cdn.yourdomain.com
S3_PUBLIC_URL=
